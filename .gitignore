# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment and secrets
.env
*.env
!.env.example

# Runtime outputs
*.log
*.err
*.html
*.png
*.json

# Keep source JSON docs, ignore runtime JSON under backtests
!QMT-TradingClaw/qgdata_docs/**/*.json

# Orchestrator runtime folders
QMT-TradingClaw/backtests/orchestrator_runs/
QMT-TradingClaw/backtests/.run_lock

# Build artifacts
*.egg-info/
.pytest_cache/
# Agent生成的策略文件（每次回测自动生成）
QMT-TradingClaw/strategies/*.py
!QMT-TradingClaw/strategies/__init__.py

# 测试报告
e2e_test_report*.md

# Cursor rules（项目本地）
.cursor/
