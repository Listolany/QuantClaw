# QuantClaw 环境配置模板
# 使用方法: cp .env.example QMT-TradingClaw/.env  然后编辑填入你的值
# 诊断工具: python3 QMT-TradingClaw/backtests/pipeline_orchestrator.py config-doctor
# 详细指南: https://gitee.com/GuojinQuant/quant-claw

# ─── 必需 ────────────────────────────────────────────────
# 项目根目录（clone 后自动指向 QMT-TradingClaw）
QMT_PROJECT_ROOT=./QMT-TradingClaw

# qgdata 数据 Token（Pro 套餐，获取: https://quantgo.ai/data）
QGDATA_TOKEN=

# 监控页公网基址（你的服务器公网 IP 或域名，不带端口）
# 示例: http://123.45.67.89  或  https://quant.example.com
MONITOR_PUBLIC_BASE=

# ─── 可选（有默认值） ────────────────────────────────────
# Python 解释器路径
# PYTHON_BIN=python3

# 监控页白名单端口（逗号分隔，必须在防火墙/安全组放通）
# ORCH_MONITOR_PORT_CANDIDATES=8767

# OpenClaw 控制台地址（配置后可自动推导 MONITOR_PUBLIC_BASE，二选一即可）
# OPENCLAW_CONTROL_URL=http://your-server:18789

# ─── 可选（持久化报告） ──────────────────────────────────
# 静态报告公网基址（需 Nginx/Caddy 映射到 REPORT_PUBLIC_DIR）
# REPORT_PUBLIC_BASE=http://your-server/reports

# 静态报告落盘目录
# REPORT_PUBLIC_DIR=/var/www/reports

# ─── 回测超时 ────────────────────────────────────────────
# ORCH_BACKTEST_TIMEOUT_SEC=1200
